# Valores de `npx supabase status` en local; del panel de Supabase en producción.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas al navegador.
SUPABASE_SECRET_KEY=
# Dirección pública del panel, para los enlaces que se envían por WhatsApp (reporte, cotización).
NEXT_PUBLIC_SITE_URL=http://localhost:4000
# Sentry (plan gratis). Sin DSN no se envía nada. El DSN es público; el token NO (solo en el build).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Aviso por correo con cada solicitud de demo de la página pública (Resend, plan gratis).
# Sin estas variables los interesados igual quedan guardados en la tabla leads.
RESEND_API_KEY=
LEAD_NOTIFY_EMAIL=
# Remitente con tu dominio verificado en Resend (si no, se usa el de pruebas de Resend).
LEAD_FROM_EMAIL=
# Analítica de la página pública con Umami Cloud (plan Hobby gratis, sin cookies). Vacío = no mide.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
