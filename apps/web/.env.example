# Valores de `npx supabase status` en local; del panel de Supabase en producción.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Solo servidor. Nunca la expongas al navegador.
SUPABASE_SECRET_KEY=
# Dirección pública del panel, para los enlaces que se envían por WhatsApp (reporte, cotización).
NEXT_PUBLIC_SITE_URL=http://localhost:4000
# Sentry (plan gratis). Sin DSN no se envía nada. El DSN es público; el token NO (solo en el build).
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
