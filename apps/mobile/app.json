{
  "expo": {
    "name": "Tecnio",
    "slug": "tecnio",
    "scheme": "tecnio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.tecnio.app"
    },
    "android": {
      "package": "co.tecnio.app",
      "adaptiveIcon": {
        "backgroundColor": "#C2400D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10211C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Tecnio guarda tu ubicación al salir y al llegar a cada servicio."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Tecnio usa la cámara para las fotos del antes y el después del servicio.",
          "photosPermission": "Tecnio usa tus fotos para adjuntarlas a la orden.",
          "microphonePermission": false
        }
      ],
      "@sentry/react-native"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e685d186-bc70-4a71-8b26-d0d47967d534"
      }
    },
    "owner": "candrex"
  }
}
